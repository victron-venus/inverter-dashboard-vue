{
  "version_file": "package.json",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "npm ci --ignore-scripts",
    "npm run typecheck",
    "npm run lint",
    "npm test",
    "npm run build:all"
  ],
  "notes": [
    "SPA and library tarballs are promoted unchanged. Browser/device acceptance remains a release operator check."
  ],
  "repository": "victron-venus/inverter-dashboard-vue",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "package.json",
        "format": "json",
        "value": "package",
        "field": "version"
      },
      {
        "path": "package-lock.json",
        "format": "npm-lock",
        "value": "package",
        "package": "inverter-dashboard-vue"
      }
    ],
    "artifacts": [
      {
        "path": "vue-spa-dist.tar.gz",
        "format": "tar-json",
        "value": "package",
        "member": "build-info.json",
        "field": "version"
      },
      {
        "path": "vue-library-dist.tar.gz",
        "format": "tar-json",
        "value": "package",
        "member": "build-info.json",
        "field": "version"
      }
    ],
    "toolkit_revision": "5b498755c6357b034be0221f51633bab69e2380e"
  },
  "single_entry_ci": true,
  "release_notes": "CHANGELOG.md",
