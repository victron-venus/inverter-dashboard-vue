{
  "name": "inverter-dashboard-vue",
  "private": true,
  "version": "2.2.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:spa": "vue-tsc --noEmit && vite build",
    "build:lib": "vue-tsc --noEmit && vite build --mode lib",
    "build:all": "npm run build:spa && npm run build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.0",
    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/presets": "1.2.0",
    "echarts": "^6.1.0",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13"
  }
}
