{
  "name": "inverter-dashboard-vue",
  "private": true,
  "version": "2.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:spa": "vue-tsc --noEmit && vite build",
    "build:lib": "vue-tsc --noEmit && vite build --mode lib",
    "build:all": "npm run build:spa && npm run build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.41.0",
    "@tailwindcss/vite": "^4.3.0",
    "echarts": "^6.1.0",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "3.3.11"
  }
}
