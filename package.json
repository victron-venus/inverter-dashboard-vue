{
  "name": "inverter-dashboard-vue",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:spa": "tsc && vite build",
    "build:lib": "tsc && vite build --mode lib",
    "build:all": "npm run build:spa && npm run build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.35.0",
    "@tailwindcss/vite": "^4.3.0",
    "echarts": "^6.1.0",
    "vue": "^3.5.42",
    "vue-echarts": "^8.2.0",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.0",
    "biome": "^0.3.3",
    "happy-dom": "^20.11.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
