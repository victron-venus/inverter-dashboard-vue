{
  "schema": 1,
  "language": "javascript",
  "setup": [
    [
      "npm",
      "ci",
      "--omit=dev",
      "--ignore-scripts",
      "--no-audit",
      "--no-fund"
    ],
    [
      "npm",
      "ci",
      "--prefix",
      "fuzz",
      "--ignore-scripts",
      "--no-audit",
      "--no-fund"
    ],
    [
      "node",
      "fuzz/build.mjs"
    ]
  ],
  "targets": [
    {
      "name": "ess-mode",
      "engine": "libfuzzer",
      "command": [
        "node",
        "fuzz/node_modules/@jazzer.js/core/dist/cli.js",
        "fuzz/ess-mode.mjs",
        "--sync",
        "--"
      ],
      "corpus": "fuzz/corpus/ess-mode",
      "seconds": 60
    },
    {
      "name": "telemetry",
      "engine": "libfuzzer",
      "command": [
        "node",
        "fuzz/node_modules/@jazzer.js/core/dist/cli.js",
        "fuzz/telemetry.mjs",
        "--sync",
        "--"
      ],
      "corpus": "fuzz/corpus/telemetry",
      "seconds": 60
    }
  ],
  "preflight": [
    [
      "node",
      "fuzz/replay.mjs"
    ]
  ]
}
